page {
  min-height: 100vh;
  background: #120b07;
  color: #e4c58e;
  font-family: "STKaiti", "KaiTi", "Songti SC", serif;
}

button,
input,
textarea {
  font-family: inherit;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0;
  border: 0;
  line-height: 1;
  background: transparent;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 28%, rgba(105, 62, 33, 0.62), transparent 34%),
    radial-gradient(circle at 50% 62%, rgba(98, 22, 30, 0.22), transparent 42%),
    radial-gradient(circle at 50% 38%, rgba(82, 48, 27, 0.9), rgba(24, 13, 7, 0.86) 48%, #050302 100%);
}

.page-shell::before {
  content: "";
  position: absolute;
  inset: 36rpx;
  border: 2rpx solid rgba(191, 145, 74, 0.45);
  box-shadow: inset 0 0 0 18rpx rgba(30, 17, 9, 0.78);
  pointer-events: none;
}

.page-shell::after {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.2;
  pointer-events: none;
  background-image:
    radial-gradient(circle at center, rgba(235, 195, 123, 0.13) 0 1rpx, transparent 2rpx),
    linear-gradient(108deg, transparent 0 32%, rgba(223, 183, 114, 0.18) 33%, transparent 35%),
    linear-gradient(18deg, transparent 0 46%, rgba(128, 72, 31, 0.22) 47%, transparent 49%);
  background-size: 72rpx 72rpx, 180rpx 180rpx, 220rpx 220rpx;
}

.safe-content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 64rpx 72rpx;
}

.gold-line {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(222, 184, 108, 0.72), transparent);
}

.seal-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 456rpx;
  height: 140rpx;
  box-sizing: border-box;
  color: #f6ddb0;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  text-indent: 4rpx;
  letter-spacing: 4rpx;
  background: linear-gradient(180deg, #8a2027, #68131b);
  border: 4rpx solid #d0a35f;
  border-radius: 8rpx;
  box-shadow:
    0 24rpx 36rpx rgba(0, 0, 0, 0.48),
    inset 0 0 0 4rpx rgba(155, 44, 54, 0.9),
    inset 0 12rpx 22rpx rgba(246, 221, 176, 0.08);
}

.seal-button-active {
  transform: translateY(4rpx) scale(0.985);
  box-shadow:
    0 14rpx 24rpx rgba(0, 0, 0, 0.42),
    inset 0 0 0 4rpx rgba(155, 44, 54, 0.9);
}

.muted-text {
  color: #8a6b4a;
  font-size: 24rpx;
}

.page-transfer {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 46%, rgba(116, 24, 32, 0.38), transparent 34%),
    rgba(5, 3, 2, 0.82);
}

.transfer-seal {
  width: 132rpx;
  height: 132rpx;
  color: #f6ddb0;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 132rpx;
  text-align: center;
  background: #7b1c20;
  border: 5rpx solid #d0a35f;
  border-radius: 8rpx;
  box-shadow: 0 0 44rpx rgba(123, 28, 32, 0.72);
  animation: transferSeal 360ms ease both;
}

@keyframes fadeRise {
  from {
    opacity: 0;
    transform: translateY(28rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes transferIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes transferSeal {
  0% {
    opacity: 0;
    transform: translateY(-46rpx) scale(1.18);
  }
  60% {
    opacity: 1;
    transform: translateY(8rpx) scale(0.92);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes breathe {
  0%, 100% {
    transform: scale(1);
    opacity: 0.96;
  }
  50% {
    transform: scale(1.025);
    opacity: 1;
  }
}

@keyframes sealPulse {
  0%, 100% {
    transform: translateY(0);
    box-shadow: 0 24rpx 36rpx rgba(0, 0, 0, 0.48), inset 0 0 0 4rpx rgba(155, 44, 54, 0.9);
  }
  50% {
    transform: translateY(-6rpx);
    box-shadow: 0 34rpx 48rpx rgba(0, 0, 0, 0.58), inset 0 0 0 4rpx rgba(202, 85, 67, 0.95);
  }
}

@keyframes drawIn {
  from {
    opacity: 0;
    transform: scaleX(0.2);
  }
  to {
    opacity: 1;
    transform: scaleX(1);
  }
}

@keyframes lotDrop {
  0% {
    opacity: 0;
    transform: translateY(-120rpx) rotate(-10deg);
  }
  60% {
    opacity: 1;
    transform: translateY(18rpx) rotate(5deg);
  }
  100% {
    opacity: 1;
    transform: translateY(0) rotate(0);
  }
}
