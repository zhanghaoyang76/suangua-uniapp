page {
  min-height: 100vh;
  background: #120b07;
  color: #e4c58e;
  font-family: "STKaiti", "KaiTi", "Songti SC", serif;
}

button,
input,
textarea {
  font-family: inherit;
}

button {
  padding: 0;
  border: 0;
  background: transparent;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 38%, rgba(82, 48, 27, 0.9), rgba(24, 13, 7, 0.86) 48%, #050302 100%);
}

.page-shell::before {
  content: "";
  position: absolute;
  inset: 36rpx;
  border: 2rpx solid rgba(191, 145, 74, 0.45);
  box-shadow: inset 0 0 0 18rpx rgba(30, 17, 9, 0.78);
  pointer-events: none;
}

.page-shell::after {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.18;
  pointer-events: none;
  background-image:
    linear-gradient(108deg, transparent 0 32%, rgba(223, 183, 114, 0.18) 33%, transparent 35%),
    linear-gradient(18deg, transparent 0 46%, rgba(128, 72, 31, 0.22) 47%, transparent 49%);
  background-size: 180rpx 180rpx, 220rpx 220rpx;
}

.safe-content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 64rpx 72rpx;
}

.gold-line {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(222, 184, 108, 0.72), transparent);
}

.seal-button {
  width: 456rpx;
  height: 140rpx;
  color: #f6ddb0;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  background: #741820;
  border: 4rpx solid #d0a35f;
  box-shadow: 0 24rpx 36rpx rgba(0, 0, 0, 0.48), inset 0 0 0 4rpx rgba(155, 44, 54, 0.9);
  clip-path: polygon(9% 0, 91% 0, 100% 28%, 100% 100%, 9% 100%, 0 72%, 0 0);
}

.muted-text {
  color: #8a6b4a;
  font-size: 24rpx;
}

@keyframes fadeRise {
  from {
    opacity: 0;
    transform: translateY(28rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes breathe {
  0%, 100% {
    transform: scale(1);
    opacity: 0.96;
  }
  50% {
    transform: scale(1.025);
    opacity: 1;
  }
}

@keyframes sealPulse {
  0%, 100% {
    transform: translateY(0);
    box-shadow: 0 24rpx 36rpx rgba(0, 0, 0, 0.48), inset 0 0 0 4rpx rgba(155, 44, 54, 0.9);
  }
  50% {
    transform: translateY(-6rpx);
    box-shadow: 0 34rpx 48rpx rgba(0, 0, 0, 0.58), inset 0 0 0 4rpx rgba(202, 85, 67, 0.95);
  }
}

@keyframes drawIn {
  from {
    opacity: 0;
    transform: scaleX(0.2);
  }
  to {
    opacity: 1;
    transform: scaleX(1);
  }
}

@keyframes lotDrop {
  0% {
    opacity: 0;
    transform: translateY(-120rpx) rotate(-10deg);
  }
  60% {
    opacity: 1;
    transform: translateY(18rpx) rotate(5deg);
  }
  100% {
    opacity: 1;
    transform: translateY(0) rotate(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .page-shell *,
  .page-shell *::before,
  .page-shell *::after {
    animation: none !important;
    transition: none !important;
  }
}
