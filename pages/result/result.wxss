.result-content {
  padding-bottom: 96rpx;
}

.result-title,
.result-line,
.question-text,
.meta-row,
.bureau-strip,
.steps,
.palace-grid,
.reading,
.result-actions {
  opacity: 0;
  transform: translateY(28rpx);
}

.result.ready .result-title {
  animation: resultLayerIn 420ms ease both;
}

.result.ready .result-line {
  animation: resultLayerIn 420ms 40ms ease both;
}

.result.ready .question-text {
  animation: resultLayerIn 420ms 80ms ease both;
}

.result.ready .meta-row {
  animation: resultLayerIn 420ms 140ms ease both;
}

.result.ready .bureau-strip {
  animation: resultLayerIn 420ms 220ms ease both;
}

.result.ready .steps {
  animation: resultLayerIn 420ms 300ms ease both;
}

.result.ready .palace-grid {
  animation: resultLayerIn 460ms 380ms ease both;
}

.result.ready .reading {
  animation: resultLayerIn 460ms 460ms ease both;
}

.result.ready .result-actions {
  animation: resultLayerIn 420ms 540ms ease both;
}

.result.leaving .result-content {
  animation: resultFadeOut 320ms ease both;
}

.result-title {
  margin-top: 28rpx;
  color: #e0c18a;
  font-size: 56rpx;
  font-weight: 700;
  text-align: center;
}

.result-line {
  width: 420rpx;
  margin: 30rpx auto 48rpx;
  animation: drawIn 820ms ease both;
}

.question-text {
  color: #caa66a;
  font-size: 30rpx;
  line-height: 1.55;
  text-align: center;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  color: #9d7b4e;
  font-size: 24rpx;
}

.meta-row.strong {
  color: #e0c18a;
  font-size: 30rpx;
  font-weight: 700;
}

.bureau-strip {
  display: flex;
  gap: 14rpx;
  margin-top: 34rpx;
}

.bureau-item {
  display: flex;
  flex: 1;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  height: 136rpx;
  box-sizing: border-box;
  background: rgba(10, 6, 4, 0.56);
  border: 2rpx solid rgba(177, 128, 61, 0.52);
  box-shadow: inset 0 0 0 5rpx rgba(38, 22, 12, 0.46);
}

.bureau-label {
  color: #8b6b44;
  font-size: 22rpx;
  line-height: 1;
}

.bureau-main {
  margin-top: 12rpx;
  color: #e0c18a;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.bureau-sub {
  margin-top: 12rpx;
  color: #a98756;
  font-size: 21rpx;
  line-height: 1;
}

.steps {
  margin-top: 42rpx;
  padding: 30rpx 34rpx;
  background: rgba(10, 6, 4, 0.48);
  border: 2rpx solid rgba(177, 128, 61, 0.52);
  box-shadow: inset 0 0 0 6rpx rgba(38, 22, 12, 0.5);
}

.step-item {
  color: #b89562;
  font-size: 25rpx;
  line-height: 1.8;
}

.palace-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 42rpx;
  padding: 8rpx;
  background: rgba(184, 138, 69, 0.58);
  box-shadow: 0 28rpx 44rpx rgba(0, 0, 0, 0.34);
}

.palace-cell {
  width: 33.3333%;
  min-height: 160rpx;
  padding: 16rpx 10rpx;
  box-sizing: border-box;
  text-align: center;
  background: #130b07;
  border: 2rpx solid rgba(82, 49, 25, 0.9);
}

.palace-cell.key {
  background: #241008;
  box-shadow: inset 0 0 0 4rpx rgba(123, 28, 32, 0.78);
}

.cell-top {
  color: #8b6b44;
  font-size: 20rpx;
}

.cell-door {
  margin-top: 8rpx;
  color: #e0c18a;
  font-size: 30rpx;
  font-weight: 700;
}

.cell-sub,
.cell-stem {
  margin-top: 8rpx;
  color: #a98756;
  font-size: 21rpx;
}

.reading {
  position: relative;
  margin-top: 48rpx;
  padding: 42rpx 34rpx 34rpx;
  background: rgba(9, 5, 3, 0.62);
  border: 3rpx solid rgba(177, 128, 61, 0.62);
}

.level-mark {
  position: absolute;
  top: -30rpx;
  right: 32rpx;
  width: 82rpx;
  height: 82rpx;
  color: #f0d5aa;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 82rpx;
  text-align: center;
  background: #7b1c20;
  border: 3rpx solid #d0a35f;
}

.reading-title {
  color: #e0c18a;
  font-size: 36rpx;
  font-weight: 700;
}

.reading-text,
.reading-item {
  margin-top: 22rpx;
  color: #caa66a;
  font-size: 28rpx;
  line-height: 1.72;
}

.reading-item text {
  color: #e0c18a;
  font-weight: 700;
}

.result-actions {
  margin-top: 42rpx;
}

.ai-button,
.home-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  box-sizing: border-box;
  color: #e7c899;
  font-size: 30rpx;
  line-height: 1;
  text-align: center;
  background: rgba(116, 24, 32, 0.78);
  border: 3rpx solid rgba(208, 163, 95, 0.86);
  box-shadow: 0 18rpx 28rpx rgba(0, 0, 0, 0.28), inset 0 0 0 4rpx rgba(155, 44, 54, 0.38);
}

.home-button {
  margin-top: 24rpx;
  color: #d6b979;
  background: rgba(10, 6, 4, 0.58);
  box-shadow: inset 0 0 0 4rpx rgba(36, 21, 11, 0.58);
}

.action-button-active {
  transform: translateY(3rpx);
  opacity: 0.86;
}

.result-transfer {
  animation: transferIn 320ms ease both;
}

@keyframes resultLayerIn {
  from {
    opacity: 0;
    transform: translateY(28rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes resultFadeOut {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(18rpx);
  }
}
