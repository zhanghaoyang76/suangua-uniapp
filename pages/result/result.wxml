<view class="page-shell result {{ready ? 'ready' : ''}} {{leaving ? 'leaving' : ''}}">
  <view class="safe-content result-content">
    <view class="result-title">本局已成</view>
    <view class="gold-line result-line"></view>

    <view class="question-text">“{{question}}”</view>

    <view class="meta-row">
      <text>{{chart.timeText}}</text>
      <text>{{chart.solarTerm}} {{chart.yuan}}</text>
    </view>
    <view class="meta-row strong">
      <text>{{chart.dun}}{{chart.juNumber}}局</text>
      <text>日 {{chart.dayGanzhi}} · 时 {{chart.hourGanzhi}}</text>
    </view>

    <view class="bureau-strip">
      <view class="bureau-item">
        <text class="bureau-label">值符</text>
        <text class="bureau-main">{{chart.valueSymbol.star}}</text>
        <text class="bureau-sub">{{chart.valueSymbol.palace}}</text>
      </view>
      <view class="bureau-item">
        <text class="bureau-label">值使</text>
        <text class="bureau-main">{{chart.valueEnvoy.door}}</text>
        <text class="bureau-sub">{{chart.valueEnvoy.palace}}</text>
      </view>
      <view class="bureau-item">
        <text class="bureau-label">用宫</text>
        <text class="bureau-main">{{chart.keyPalace.door}}</text>
        <text class="bureau-sub">{{chart.keyPalace.name}}</text>
      </view>
    </view>

    <view class="steps">
      <view wx:for="{{chart.processSteps}}" wx:key="*this" class="step-item">{{item}}</view>
    </view>

    <view class="palace-grid">
      <view wx:for="{{chart.palaces}}" wx:key="id" class="palace-cell {{item.isKey ? 'key' : ''}}">
        <view class="cell-top">{{item.direction}}</view>
        <view class="cell-door">{{item.door}}</view>
        <view class="cell-sub">{{item.star}} · {{item.god}}</view>
        <view class="cell-stem">{{item.heavenlyStem}} / {{item.earthlyStem}}</view>
      </view>
    </view>

    <view class="reading">
      <view class="level-mark">{{reading.level}}</view>
      <view class="reading-title">传统断语</view>
      <view class="reading-text">{{reading.summary}}</view>
      <view class="reading-item"><text>宜：</text>{{reading.suitable}}</view>
      <view class="reading-item"><text>忌：</text>{{reading.avoid}}</view>
      <view class="reading-item"><text>提醒：</text>{{reading.advice}}</view>
    </view>

    <view class="result-actions">
      <button class="ai-button" hover-class="action-button-active" bindtap="askAi">AI 深度解读</button>
      <button class="home-button" hover-class="action-button-active" bindtap="backHome">返回首页</button>
    </view>
  </view>

  <view wx:if="{{leaving}}" class="page-transfer result-transfer">
    <view class="transfer-seal">归</view>
  </view>
</view>
