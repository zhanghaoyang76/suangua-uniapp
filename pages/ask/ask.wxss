.ask-content {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  padding-top: 88rpx;
  padding-bottom: 88rpx;
}

.ask-title {
  color: #e0c18a;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.18;
  text-align: center;
  text-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.48);
  animation: fadeRise 700ms ease both;
}

.ask-line {
  width: 420rpx;
  margin: 30rpx 0 58rpx;
  animation: drawIn 800ms ease both;
}

.question-input {
  width: 590rpx;
  height: 284rpx;
  padding: 36rpx 38rpx;
  box-sizing: border-box;
  color: #f0d5aa;
  font-size: 32rpx;
  line-height: 1.65;
  background:
    linear-gradient(180deg, rgba(22, 12, 7, 0.84), rgba(9, 5, 3, 0.7));
  border: 3rpx solid rgba(199, 148, 72, 0.78);
  box-shadow:
    inset 0 0 0 8rpx rgba(36, 21, 11, 0.72),
    inset 0 18rpx 34rpx rgba(222, 184, 108, 0.06),
    0 24rpx 42rpx rgba(0, 0, 0, 0.36);
  animation: fadeRise 760ms 80ms ease both;
}

.question-placeholder {
  color: rgba(166, 128, 81, 0.68);
}

.ritual-panel {
  width: 590rpx;
  margin-top: 42rpx;
  padding: 22rpx 26rpx;
  box-sizing: border-box;
  background: rgba(10, 6, 4, 0.46);
  border: 2rpx solid rgba(177, 128, 61, 0.52);
  box-shadow: inset 0 0 0 6rpx rgba(38, 22, 12, 0.42);
  animation: fadeRise 760ms 120ms ease both;
}

.ritual-step {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  opacity: 0.52;
}

.ritual-step + .ritual-step {
  border-top: 1rpx solid rgba(208, 163, 95, 0.16);
}

.ritual-step.current,
.ritual-step.done {
  opacity: 1;
}

.ritual-mark {
  width: 38rpx;
  height: 38rpx;
  margin-right: 20rpx;
  box-sizing: border-box;
  color: #7a5127;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(12, 7, 4, 0.72);
  border: 3rpx solid rgba(176, 128, 61, 0.66);
  border-radius: 4rpx;
}

.ritual-step.current .ritual-mark,
.ritual-step.done .ritual-mark {
  color: #5b3219;
  background: #d0a35f;
  border-color: #f0d5aa;
  box-shadow: 0 0 18rpx rgba(224, 193, 138, 0.48);
}

.ritual-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.ritual-title {
  color: #e0c18a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.ritual-note {
  margin-top: 6rpx;
  color: #9d7b4e;
  font-size: 22rpx;
  line-height: 1.35;
}

.cast-hint {
  margin-top: 18rpx;
  color: #a98756;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: center;
  animation: fadeRise 760ms 150ms ease both;
}

.cast-button {
  margin-top: 40rpx;
  animation: sealPulse 3s ease-in-out infinite;
}

.cast-button.seal-button-active {
  animation: none;
}

.casting-mask {
  position: fixed;
  z-index: 9;
  inset: 0;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 42%, rgba(116, 24, 32, 0.28), transparent 38%),
    rgba(5, 3, 2, 0.9);
}

.casting-scene {
  position: relative;
  width: 360rpx;
  height: 340rpx;
}

.seal-scene,
.time-scene,
.dun-scene,
.grid-scene,
.envoy-scene {
  display: none;
}

.casting-scene.seal .seal-scene,
.casting-scene.time .time-scene,
.casting-scene.dun .dun-scene,
.casting-scene.grid .grid-scene,
.casting-scene.envoy .envoy-scene {
  display: block;
}

.seal-paper {
  position: absolute;
  left: 58rpx;
  top: 42rpx;
  width: 244rpx;
  height: 256rpx;
  background: linear-gradient(180deg, #d7ba78, #8f642e);
  border: 3rpx solid #e2c98d;
  box-shadow: 0 20rpx 34rpx rgba(0, 0, 0, 0.45);
  animation: paperRise 720ms ease both;
}

.seal-stamp {
  position: absolute;
  left: 126rpx;
  top: 116rpx;
  width: 108rpx;
  height: 108rpx;
  color: #f6ddb0;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 108rpx;
  text-align: center;
  background: #7b1c20;
  border: 5rpx solid #d0a35f;
  border-radius: 8rpx;
  box-shadow: 0 0 30rpx rgba(123, 28, 32, 0.64);
  animation: stampPress 720ms ease both;
}

.time-ring {
  position: absolute;
  left: 50rpx;
  top: 40rpx;
  width: 260rpx;
  height: 260rpx;
  border: 4rpx solid rgba(208, 163, 95, 0.86);
  border-radius: 50%;
  box-shadow:
    inset 0 0 0 18rpx rgba(36, 21, 11, 0.72),
    0 0 34rpx rgba(224, 193, 138, 0.18);
  animation: ringGlow 900ms ease both;
}

.time-mark {
  position: absolute;
  color: #e0c18a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.time-mark.top {
  top: 22rpx;
  left: 112rpx;
}

.time-mark.right {
  top: 112rpx;
  right: 22rpx;
}

.time-mark.bottom {
  bottom: 22rpx;
  left: 112rpx;
}

.time-mark.left {
  top: 112rpx;
  left: 22rpx;
}

.time-hand {
  position: absolute;
  left: 128rpx;
  top: 48rpx;
  width: 4rpx;
  height: 90rpx;
  background: #d0a35f;
  box-shadow: 0 0 16rpx rgba(224, 193, 138, 0.6);
  transform-origin: 50% 82rpx;
  animation: timeSweep 900ms ease both;
}

.dun-card {
  position: absolute;
  top: 78rpx;
  width: 118rpx;
  height: 158rpx;
  color: #f0d5aa;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 158rpx;
  text-align: center;
  background: linear-gradient(180deg, #7b1c20, #411016);
  border: 4rpx solid #d0a35f;
  box-shadow: 0 22rpx 36rpx rgba(0, 0, 0, 0.42);
}

.dun-card.front {
  left: 66rpx;
  animation: dunFlipLeft 820ms ease both;
}

.dun-card.back {
  right: 66rpx;
  animation: dunFlipRight 820ms ease both;
}

.dun-number {
  position: absolute;
  left: 144rpx;
  top: 122rpx;
  width: 72rpx;
  height: 72rpx;
  color: #5b3219;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
  background: #d0a35f;
  border-radius: 50%;
  animation: dunCenter 820ms ease both;
}

.grid-scene {
  position: absolute;
  left: 48rpx;
  top: 36rpx;
  width: 264rpx;
  height: 264rpx;
}

.grid-cell {
  float: left;
  width: 88rpx;
  height: 88rpx;
  box-sizing: border-box;
  color: #e0c18a;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: center;
  background: rgba(19, 11, 7, 0.9);
  border: 2rpx solid rgba(208, 163, 95, 0.62);
  opacity: 0;
  animation: gridLight 620ms ease both;
}

.grid-cell:nth-child(2) { animation-delay: 60ms; }
.grid-cell:nth-child(3) { animation-delay: 120ms; }
.grid-cell:nth-child(4) { animation-delay: 180ms; }
.grid-cell:nth-child(5) { animation-delay: 240ms; }
.grid-cell:nth-child(6) { animation-delay: 300ms; }
.grid-cell:nth-child(7) { animation-delay: 360ms; }
.grid-cell:nth-child(8) { animation-delay: 420ms; }
.grid-cell:nth-child(9) { animation-delay: 480ms; }

.envoy-token {
  position: absolute;
  top: 92rpx;
  width: 94rpx;
  height: 150rpx;
  color: #6e1c22;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 150rpx;
  text-align: center;
  background: linear-gradient(#d7ba78, #8f642e);
  border: 3rpx solid #e2c98d;
  box-shadow: 0 20rpx 34rpx rgba(0, 0, 0, 0.45);
}

.envoy-token.symbol {
  left: 68rpx;
  animation: envoyLeft 780ms ease both;
}

.envoy-token.envoy {
  right: 68rpx;
  animation: envoyRight 780ms ease both;
}

.envoy-center {
  position: absolute;
  left: 142rpx;
  top: 130rpx;
  width: 76rpx;
  height: 76rpx;
  color: #f6ddb0;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
  background: #7b1c20;
  border: 4rpx solid #d0a35f;
  border-radius: 50%;
  opacity: 0;
  animation: envoyCenter 780ms 240ms ease both;
}

.casting-text {
  margin-top: 20rpx;
  color: #d6b979;
  font-size: 30rpx;
}

.casting-subtext {
  margin-top: 14rpx;
  color: #9d7b4e;
  font-size: 24rpx;
}

.ask-transfer {
  animation: transferIn 360ms ease both;
}

.transfer-grid {
  display: flex;
  flex-wrap: wrap;
  width: 252rpx;
  height: 252rpx;
  padding: 6rpx;
  box-sizing: border-box;
  background: rgba(208, 163, 95, 0.18);
  border: 3rpx solid rgba(208, 163, 95, 0.84);
  animation: transferGridClose 360ms ease both;
}

.transfer-grid text {
  width: 33.3333%;
  height: 33.3333%;
  box-sizing: border-box;
  background: rgba(123, 28, 32, 0.62);
  border: 2rpx solid rgba(208, 163, 95, 0.5);
}

@keyframes paperRise {
  from {
    opacity: 0;
    transform: translateY(56rpx) scale(0.92);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes transferGridClose {
  from {
    opacity: 0;
    transform: scale(1.34) rotate(8deg);
  }
  to {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
}

@keyframes stampPress {
  0% {
    opacity: 0;
    transform: translateY(-80rpx) scale(1.18);
  }
  58% {
    opacity: 1;
    transform: translateY(10rpx) scale(0.88);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes ringGlow {
  from {
    opacity: 0;
    transform: scale(0.82);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes timeSweep {
  from {
    transform: rotate(-120deg);
  }
  to {
    transform: rotate(250deg);
  }
}

@keyframes dunFlipLeft {
  from {
    opacity: 0;
    transform: rotateY(88deg) translateX(-42rpx);
  }
  to {
    opacity: 1;
    transform: rotateY(0) translateX(0);
  }
}

@keyframes dunFlipRight {
  from {
    opacity: 0;
    transform: rotateY(-88deg) translateX(42rpx);
  }
  to {
    opacity: 1;
    transform: rotateY(0) translateX(0);
  }
}

@keyframes dunCenter {
  from {
    opacity: 0;
    transform: scale(0.4);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes gridLight {
  from {
    opacity: 0;
    transform: scale(0.76);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes envoyLeft {
  from {
    opacity: 0;
    transform: translateX(-86rpx) rotate(-14deg);
  }
  to {
    opacity: 1;
    transform: translateX(0) rotate(-4deg);
  }
}

@keyframes envoyRight {
  from {
    opacity: 0;
    transform: translateX(86rpx) rotate(14deg);
  }
  to {
    opacity: 1;
    transform: translateX(0) rotate(4deg);
  }
}

@keyframes envoyCenter {
  from {
    opacity: 0;
    transform: scale(0.48);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
